# 复制为 .env 后使用：cp .env.example .env
# 禁止在本文件写入真实 API Key，只保留占位符。

# ---- 数据库 ----
# SQLite（默认，本机零依赖）
DATABASE_URL="file:./dev.db"
# Postgres（docker-compose 方式，改用 prisma/schema.postgres.prisma）
# DATABASE_URL="postgresql://wfm:wfm@localhost:5432/wfm?schema=public"

# ---- 认证 ----
AUTH_SECRET="dev-secret-change-me"
FIXED_OTP_CODE="123456"
CLOCK_CODE_SECRET="replace-with-a-long-random-secret"

# ---- LLM ----
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
LLM_MODEL_ASSISTANT="claude-haiku-4-5"
LLM_MODEL_SCHEDULE_PARSE="claude-sonnet-4-5"
LLM_MODEL_AUDIT_CHECK="claude-sonnet-4-5"
LLM_MODEL_SCHEDULE_EXPLAIN="claude-haiku-4-5"

# ---- Embedding ----
EMBEDDING_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---- 优化引擎 ----
SCHEDULE_ENGINE_URL="http://localhost:8000"
# Vercel 演示环境可设为 demo，使用内置 TypeScript 约束排班器
SCHEDULE_ENGINE_MODE="python"

# ---- 排班约束 ----
MAX_WEEKLY_HOURS=40
MIN_REST_HOURS=8
SHIFT_HOURS=4
